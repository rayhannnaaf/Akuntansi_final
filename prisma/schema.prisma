generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model akun {
  id           Int            @id @default(autoincrement())
  kode         String         @unique
  nama         String
  tipe         String
  saldo_awal   Decimal?       @default(0) @db.Decimal(15, 2)
  keterangan   String?
  aktif        Boolean?       @default(true)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  jurnal_entri jurnal_entri[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jurnal_entri {
  id           Int        @id @default(autoincrement())
  transaksi_id Int?
  akun_id      Int?
  debit        Decimal?   @default(0) @db.Decimal(15, 2)
  kredit       Decimal?   @default(0) @db.Decimal(15, 2)
  keterangan   String?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  akun         akun?      @relation(fields: [akun_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaksi    transaksi? @relation(fields: [transaksi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id         String      @id @db.Uuid
  nama       String
  email      String
  role       String      @default("siswa")
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  users      users       @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaksi  transaksi[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transaksi {
  id           Int            @id @default(autoincrement())
  tanggal      DateTime       @db.Date
  nomor_bukti  String         @unique
  keterangan   String
  total_nilai  Decimal        @default(0) @db.Decimal(15, 2)
  created_by   String?        @db.Uuid
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  jurnal_entri jurnal_entri[]
  profiles     profiles?      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  profiles      profiles?
}
